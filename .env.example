# Runtime
NODE_ENV=production

# Server
HOST=127.0.0.1
PORT=3001
WEB_PORT=3000
WEB_HOST=127.0.0.1

# Domain
WEB_ORIGIN=https://example.com
# Leave empty to use same-origin /api through Nginx.
NEXT_PUBLIC_API_BASE_URL=
API_BASE_URL=http://127.0.0.1:3001

# Database
DATABASE_URL=/var/www/atmbNew/data/atmb.sqlite

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_DISPLAY_NAME=管理员
SESSION_SECRET=change-this-random-string-at-least-32-characters

# Uploads
ADDRESS_IMAGE_UPLOAD_DIR=/var/www/atmbNew/apps/web/public/uploads/address-images
ADDRESS_IMAGE_PUBLIC_BASE=/uploads/address-images
