{
  "name": "@atmb/extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "usaddres 地址助手：在 Anytime Mailbox / iPostal1 页面上叠加 RDI、CMRA、黑名单等信息的 Chrome / Edge 扩展",
  "scripts": {
    "prebuild": "npm run build --workspace @atmb/shared",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@atmb/shared": "1.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "esbuild": "^0.25.0"
  }
}
