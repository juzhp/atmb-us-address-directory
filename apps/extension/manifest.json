{
  "manifest_version": 3,
  "name": "usaddres 地址助手",
  "version": "0.1.0",
  "description": "在 Anytime Mailbox / iPostal1 地址页面上显示 usaddres.com 的 RDI、CMRA、USPS CMRA、C1 预审、价格、邮箱编号与黑名单信息",
  "default_locale": null,
  "permissions": ["storage"],
  "host_permissions": ["https://usaddres.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "usaddres 地址助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.anytimemailbox.com/*"],
      "js": ["content/atmb.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ipostal1.com/*", "https://www.ipostal1.com/*"],
      "js": ["content/ipostal1.js"],
      "run_at": "document_idle"
    }
  ]
}
