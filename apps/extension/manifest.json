{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.1.0",
  "description": "__MSG_extDesc__",
  "default_locale": "zh_CN",
  "homepage_url": "https://usaddres.com/",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://usaddres.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "usaddres 地址助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.anytimemailbox.com/*"
      ],
      "js": [
        "content/atmb.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ipostal1.com/*",
        "https://www.ipostal1.com/*"
      ],
      "js": [
        "content/ipostal1.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.smarty.com/products/us-address-verification*"
      ],
      "js": [
        "content/smarty.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tools.usps.com/zip-code-lookup.htm*",
        "https://zh-tools.usps.com/zip-code-lookup.htm*"
      ],
      "js": [
        "content/usps.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://usaddres.com/*"
      ],
      "js": [
        "content/usaddres.js"
      ],
      "run_at": "document_start"
    }
  ]
}
